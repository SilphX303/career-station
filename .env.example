# Reed Jobseeker API key: https://www.reed.co.uk/developers/jobseeker
CAREER_REED_KEY=
# Hours between automatic crawls
CAREER_CRAWL_HOURS=4
# Where SQLite lives (Coolify volume career-data -> /data)
CAREER_DATA_DIR=/data
# Discord webhook for high-score notifications (optional)
CAREER_DISCORD_WEBHOOK=
# Public URL used in notification links
CAREER_PUBLIC_URL=http://career.arkadia.network
# Adzuna: https://developer.adzuna.com (free)
CAREER_ADZUNA_ID=
CAREER_ADZUNA_KEY=
# Comma-separated RSS feed URLs (saved searches on CWJobs, Technojobs, etc)
CAREER_RSS_FEEDS=
# LinkedIn guest search scrape, best effort. Set 0 to disable.
CAREER_LINKEDIN=1
